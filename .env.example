# FareGuard Environment Configuration
# Copy this file to .env and adjust values as needed.

# Database
DATABASE_URL=postgresql://fareguard:fareguard@localhost:5432/fareguard
POSTGRES_USER=fareguard
POSTGRES_PASSWORD=fareguard
POSTGRES_DB=fareguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8000

# Streaming
STREAM_NAME=fareguard:ticket_events
CONSUMER_GROUP=fareguard_processors
CONSUMER_NAME=processor_1

# Data Directories
DATA_DIR=data
MODEL_DIR=models
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SYNTHETIC_DATA_DIR=data/synthetic
METADATA_DIR=data/metadata

# Simulation
SIMULATION_SPEED=1.0
RANDOM_SEED=42
ANOMALY_RATE=0.15

# Demo Limits
DEMO_ROUTE_LIMIT=10
DEMO_TRIP_LIMIT=50
DEMO_EVENT_LIMIT=1000

# Logging
LOG_LEVEL=INFO
